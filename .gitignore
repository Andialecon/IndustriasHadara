# Solo se versiona lo propio del sitio (tema Hadara y scripts).
# Núcleo de WordPress, plugins de terceros, uploads y Local WP quedan fuera.

# Ignorar todo por defecto
*

# El propio gitignore
!.gitignore

# Tema a medida
!app/
app/*
!app/public/
app/public/*
!app/public/wp-content/
app/public/wp-content/*
!app/public/wp-content/themes/
app/public/wp-content/themes/*
!app/public/wp-content/themes/hadara/
!app/public/wp-content/themes/hadara/**

# Scripts de catálogo / importación (sin salidas generadas ni capturas)
!_tools/
_tools/*
!_tools/*.php
!_tools/*.py
!_tools/*.mjs
!_tools/brand/
!_tools/brand/**

# Sistema / editor
.DS_Store
Thumbs.db
*.log
